# ══════════════════════════════════════════════════════════════════
# Material Entry Platform — Environment Sample (Enterprise)
# مقادیر Secret را هرگز در ریپو قرار ندهید؛ این فایل فقط الگوست.
# ══════════════════════════════════════════════════════════════════

# ── Database ──
# SQLite (توسعه):
DATABASE_URL=file:../db/custom.db
# PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/material_entry?schema=public

# ── Security ──
# امضای Signed URL — در Production الزامی، حداقل ۳۲ کاراکتر: openssl rand -hex 32
SIGNED_URL_SECRET=
# TTL امضای Signed URL (میلی‌ثانیه) — پیش‌فرض ۶۰۰۰۰۰ (۱۰ دقیقه)
SIGNED_URL_TTL_MS=600000
# عمر نشست (روز) — پیش‌فرض ۳۰
SESSION_TTL_DAYS=30
# اتصال نشست به User-Agent (ضد Session Hijacking) — پیش‌فرض فعال
SESSION_BIND_UA=1
# تمدید لغزان نشست (Refresh Effect) — پیش‌فرض فعال
SESSION_SLIDING=1
# کوکی Secure — در Production پیش‌فرض true (نیازمند HTTPS)
COOKIE_SECURE=
# اعتماد به هدرهای Reverse Proxy — فقط پشت Nginx/Caddy معتمد true
TRUST_PROXY=

# ── Files & Object Storage ──
# پوشهٔ ذخیرهٔ فایل‌های خصوصی (حالت local)
UPLOAD_DIR=./uploads
# local (پیش‌فرض) | s3 — برای MinIO/AWS مقدار s3
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=material-entry
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO و self-hostها: true؛ AWS: false
S3_FORCE_PATH_STYLE=true

# ── Daily Tasks — Voice & STT ──
# سقف حجم فایل صوتی (مگابایت) — پیش‌فرض ۱۵
AUDIO_MAX_MB=15
# z-ai (پیش‌فرض) | external | none
STT_PROVIDER=z-ai
STT_LANGUAGE=fa
STT_API_URL=
STT_API_KEY=

# ── Notification Channels (اختیاری — Webhook درگاه‌ها) ──
# پیامک: Webhook سازگار با درگاه‌های ایرانی (کاوه‌نگار، SMS.ir، …)
NOTIFY_SMS_WEBHOOK_URL=
# ایمیل: Webhook سرویس ایمیل تراکنشی
NOTIFY_EMAIL_WEBHOOK_URL=
# Push: Webhook پل FCM/OneSignal/…
NOTIFY_PUSH_WEBHOOK_URL=
NOTIFY_WEBHOOK_TIMEOUT_MS=8000

# ── Backup ──
# تعداد فایل‌های پشتیبان نگهداری‌شده
BACKUP_KEEP=30

# ── Deployment ──
POSTGRES_USER=smi
POSTGRES_PASSWORD=
MINIO_ROOT_USER=smi-storage
MINIO_ROOT_PASSWORD=
