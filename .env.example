# ─────────────────────────────────────────────────────────────────────────────
# سامانه هوشمند ثبت ورود مصالح کارگاه — نمونهٔ Environment
# کپی کنید:  cp .env.example .env   سپس مقادیر Secret را پر کنید.
# هیچ Secret واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────────────────────

# ── ۱) دیتابیس ──
# SQLite (توسعه):
DATABASE_URL="file:/app/db/custom.db"
# PostgreSQL (Production):
# DATABASE_URL="postgresql://user:password@postgres:5432/material_entry?schema=public"

# ── ۲) امنیت — الزامی در Production ──
# Secret امضای Signed URLها — حداقل ۳۲ کاراکتر؛ تولید:  openssl rand -hex 32
SIGNED_URL_SECRET=""
# مدت اعتبار Signed URL (میلی‌ثانیه) — پیش‌فرض 600000 (۱۰ دقیقه)
# SIGNED_URL_TTL_MS=600000
# عمر نشست کاربر (روز) — پیش‌فرض 30
# SESSION_TTL_DAYS=30
# کوکی Secure — در Production پیش‌فرض true (نیازمند HTTPS)
# COOKIE_SECURE=true
# اعتماد به هدرهای Proxy (x-forwarded-for) — فقط پشت Reverse Proxy معتمد true کنید
# TRUST_PROXY=false
# اتصال نشست به User-Agent (ضد Session Hijacking) — پیش‌فرض فعال
# SESSION_BIND_UA=1
# تمدید لغزان نشست (Refresh Effect) — پیش‌فرض فعال
# SESSION_SLIDING=1

# ── ۳) ذخیره‌سازی فایل (Object Storage) ──
# local (پیش‌فرض) | s3 (هر سرویس سازگار S3: MinIO، AWS، Wasabi، ...)
# STORAGE_PROVIDER=local
# پوشهٔ فایل‌های خصوصی (فقط برای local) — خارج از public
# UPLOAD_DIR=/app/uploads
# پیکربندی S3/MinIO:
# S3_ENDPOINT="http://minio:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="material-entry"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# برای MinIO باید true باشد:
# S3_FORCE_PATH_STYLE=true

# ── ۴) کانال‌های اعلان خارجی (اختیاری) ──
# هر کانال یک Webhook: سرور POST JSON می‌زند {phone|email|userId, title, body, ...}
# سازگار با کاوه‌نگار/SMS.ir/OneSignal/FCM Relay و ...
# NOTIFY_SMS_WEBHOOK_URL=""
# NOTIFY_EMAIL_WEBHOOK_URL=""
# NOTIFY_PUSH_WEBHOOK_URL=""
# مهلت زمانی هر Webhook (میلی‌ثانیه) — پیش‌فرض 8000
# NOTIFY_WEBHOOK_TIMEOUT_MS=8000

# توجه: ماژول صوت (ضبط پیام صوتی و تبدیل ویس به نوشتار) به‌طور کامل از سامانه حذف شده است.

# ── ۵) پشتیبان‌گیری ──
# تعداد نسخه‌های نگهداری‌شده — پیش‌فرض 7
# BACKUP_KEEP=7

# ── ۷) Docker Compose (مقادیر سرویس‌های جانبی) ──
# POSTGRES_USER=smi
# POSTGRES_PASSWORD=""
# MINIO_ROOT_USER=smi-storage
# MINIO_ROOT_PASSWORD=""
